// aRGus NDR — Jenkinsfile.dev
// Pipeline CI/CD para entorno de desarrollo (VM Vagrant)
// Consejo DAY 161 (ChatGPT/Kimi/DeepSeek convergentes)
//
// NOTA: Jenkins corre DENTRO de la VM Vagrant (/vagrant).
// Los targets que usan "vagrant ssh -c" no aplican aquí —
// las verificaciones se ejecutan nativas sobre el filesystem local.
// El vagrant-shim intercepta todas las llamadas vagrant ssh → bash local.
//
// Prerequisitos:
//   - Jenkins corriendo en http://localhost:8080 (dentro de la VM)
//   - Credential: vault-enterprise-token (Secret Text) = argus-dev-token
//   - vagrant-shim instalado en /usr/local/bin/vagrant
pipeline {
    agent {
        node {
            label ''
            customWorkspace '/vagrant'
        }
    }
    environment {
        VAULT_ADDR = 'http://127.0.0.1:8200'
    }
    stages {
        stage('Checkout') {
            steps {
                echo 'Workspace: /vagrant (montaje Vagrant — sin checkout scm)'
            }
        }
        stage('Bootstrap') {
            // Verificación nativa del entorno — equivalente a post-up-verify
            // sin vagrant ssh (ya estamos dentro de la VM)
            steps {
                sh '''
                    echo "🔍 Verificando entorno aRGus NDR..."
                    test -d /usr/lib/ml-defender/plugins \
                        || { echo "❌ plugins dir missing"; exit 1; }
                    test -f /usr/lib/ml-defender/plugins/libplugin_xgboost.so \
                        || { echo "❌ libplugin_xgboost.so missing"; exit 1; }
                    test -f /etc/ml-defender/plugins/plugin_signing.pk \
                        || { echo "❌ plugin_signing.pk missing"; exit 1; }
                    COUNT=$(sudo find /etc/ml-defender -name 'seed.bin' | wc -l | tr -d ' ')
                    [ "$COUNT" = "6" ] \
                        || { echo "❌ seeds missing (esperados 6, encontrados $COUNT)"; exit 1; }
                    echo "✅ Entorno verificado"
                '''
            }
        }
        stage('Wire Protocol') {
            // DEBT-WIRE-PROTOCOL-TEST-001 (DAY 161)
            // Gate obligatorio — sin esto el pipeline no tiene cimientos
            steps {
                sh 'make test-wire-protocol'
            }
        }
        stage('Unit Tests') {
            steps {
                sh 'make test-all'
            }
        }
        stage('Vault Start') {
            // Vault necesario para Enterprise Plugin y EMECAS++ Gate.
            // make vault-dev-start usa vagrant ssh defender -c "..." —
            // el vagrant-shim lo ejecuta localmente sin problemas.
            steps {
                sh 'make vault-dev-start'
            }
        }
        stage('Enterprise Plugin') {
            steps {
                withCredentials([string(credentialsId: 'vault-enterprise-token',
                                        variable: 'VAULT_TOKEN')]) {
                    sh 'make test-enterprise-plugin'
                }
            }
        }
        stage('EMECAS++ Gate') {
            // BACKLOG-CI-ENTERPRISE-001 (DAY 167)
            // Gate obligatorio pre-packaging — 3 actos: arranque nominal,
            // rotación bajo tráfico, vault-fault-inject token revocation.
            // Enterprise ⊃ OSS: si este stage pasa, EMECAS OSS también pasa.
            steps {
                withCredentials([string(credentialsId: 'vault-enterprise-token',
                                        variable: 'VAULT_TOKEN')]) {
                    sh '''
                        sudo rm -f /tmp/argus_e2e_snapshot.json \
                                   /tmp/argus_e2e_delta.json \
                                   /tmp/argus_fault_token.txt \
                                   /tmp/etcd_vault_smoke.log \
                                   /tmp/etcd_fault_test.log || true
                        make emecas++
                    '''
                }
            }
        }
        stage('Build .deb') {
            steps {
                sh 'echo "DEBT-PACKAGE-DEB-001 — deferred, skipping"'
            }
        }
        stage('Deploy Vagrant Test') {
            steps {
                sh 'echo "DEBT-DEPLOY-VAGRANT-001 — deferred, skipping"'
            }
        }
    }
    post {
        always {
            // vault-dev-stop usa "vagrant ssh" (diseñado para el host macOS)
            // Desde dentro de la VM lo paramos directamente
            sh 'pkill vault || true'
        }
        success {
            echo 'Pipeline dev PASSED — aRGus NDR'
        }
        failure {
            echo 'Pipeline dev FAILED — revisar logs'
        }
    }
}