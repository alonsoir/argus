# provisioning/vigilancia/argus-disco.service — [VIGILANCIA-D321] ADR-060 8e.4d: uso del disco del audit de Vault
# (scripts/vigilancia/argus_disco.py). Lo instala scripts/vigilancia/argus_disco_instalar.sh en la VM etcd.
# Sus líneas van al journal como argus-disco; el agente de Wazuh las envía (grupo argus-control).
# Sin privilegios: statvfs solo necesita llegar a la ruta, no leerla (DynamicUser, sistema de ficheros en solo lectura).
[Unit]
Description=aRGus: uso del disco del audit de Vault (argus-disco)
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I -u /opt/argus/vigilancia/argus_disco.py /etc/argus-vigilancia/disco.json
SyslogIdentifier=argus-disco
Restart=always
RestartSec=10s
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
SystemCallFilter=@system-service
MemoryMax=64M

[Install]
WantedBy=multi-user.target
