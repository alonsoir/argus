{
  "_header": "C++20 SNIFFER v3.3.3 - Day 12 Fast Detector Externalized Thresholds",
  "_refactor_notes": {
    "date": "2025-12-08",
    "changes": [
      "v3.2 (2025-10-28): Removed duplicate capture.interface fields, centralized in profiles",
      "v3.3 (2025-12-01): Added dual-NIC deployment support for host-based + gateway modes",
      "v3.3.1 (2025-12-02): Adapted for Day 8 testing - eth1 (WAN) + eth3 (LAN) mapping",
      "v3.3.2 (2025-12-07): Fixed for Day 11 - eth1 (WAN) + eth2 (LAN) after removing public_network",
      "v3.3.3 (2025-12-08): DAY 12 - Externalized Fast Detector thresholds (Via Appia Quality)"
    ]
  },
  "component": {
    "name": "cpp_evolutionary_sniffer",
    "version": "3.3.3",
    "mode": "kernel_user_hybrid",
    "kernel_version_required": "6.1.0"
  },
  "deployment": {
    "_comment": "Dual-NIC deployment configuration - Day 11 Stable Testing",
    "_architecture": "Host-based IDS (WAN eth1) + Gateway IDS (LAN eth2) simultaneous operation",
    "_vagrant_mapping": "eth0=NAT, eth1=192.168.56.20 (WAN), eth2=192.168.100.1 (LAN, Gateway)",
    "_fix_note": "eth2 is gateway after removing public_network bridge (was eth3 in Day 8)",
    "mode": "dual",
    "_mode_options": [
      "host-only",
      "gateway-only",
      "dual",
      "validation"
    ],
    "_mode_descriptions": {
      "host-only": "Single NIC - protects only this host (bastion defense)",
      "gateway-only": "Single NIC - inspects transit traffic (router mode)",
      "dual": "Dual NIC - simultaneous host protection + gateway inspection",
      "validation": "Testing mode - libpcap replay support for PCAP validation"
    },
    "host_interface": {
      "name": "eth1",
      "role": "wan",
      "mode": "host-based",
      "description": "WAN-facing interface (192.168.56.20) - protects the host from OSX attacks",
      "xdp_mode": "native",
      "promiscuous": true,
      "capture_direction": "ingress_only",
      "_behavior": "Captures packets DESTINED to this host (interface_mode=1)",
      "_day11_test": "Attack from OSX: nmap, hping3 → 192.168.56.20"
    },
    "gateway_interface": {
      "name": "eth2",
      "role": "lan",
      "mode": "gateway",
      "description": "LAN-facing interface (192.168.100.1) - inspects transit traffic",
      "xdp_mode": "native",
      "promiscuous": true,
      "capture_direction": "bidirectional",
      "_behavior": "Captures ALL transit traffic passing through (interface_mode=2)",
      "_day11_test": "PCAP replay: tcpreplay -i eth1 --mbps=1-10 dataset.pcap from client VM",
      "_fix": "Changed from eth3 to eth2 after removing public_network bridge"
    },
    "network_settings": {
      "enable_ip_forwarding": true,
      "enable_nat": false,
      "_nat_note": "NAT disabled for Day 11 testing - pure inspection mode",
      "enable_bridge_mode": false,
      "mtu": 1500,
      "txqueuelen": 10000
    },
    "performance": {
      "expected_throughput_gbps": 0.1,
      "max_pps_per_interface": 10000,
      "target_latency_us": 100,
      "buffer_tuning": {
        "rx_ring_size": 4096,
        "tx_ring_size": 4096
      },
      "_day11_reality": "XDP Generic in VirtualBox: ~1-5 Mbps sustained, ~1000 pps"
    },
    "detection": {
      "differentiate_by_interface": true,
      "tag_events_with_source": true,
      "interface_specific_thresholds": false,
      "_future": "Potential for different thresholds WAN vs LAN"
    },
    "hardware_requirements": {
      "_minimum_testing": {
        "cpu_cores": 4,
        "cpu_freq_ghz": 2.0,
        "ram_gb": 8,
        "nic": "Dual 1GbE (Intel i350 recommended)",
        "example": "Intel NUC, x86 Mini PC"
      },
      "_recommended_production": {
        "cpu_cores": 8,
        "cpu_freq_ghz": 3.0,
        "ram_gb": 16,
        "nic": "Dual 10GbE (Intel X710, Mellanox ConnectX-5)",
        "example": "Supermicro 1U, Dell PowerEdge R240"
      },
      "_reality_check": {
        "raspberry_pi_5": "~100 Mbps (insufficient for 1Gbps)",
        "raspberry_pi_cm4_dual_nic": "~500 Mbps (marginal)",
        "x86_n100_mini_pc": "~1 Gbps (sweet spot for SMB)",
        "virtualbox_xdp_generic": "~1-5 Mbps (Day 11 lab environment)"
      }
    },
    "validation_mode": {
      "enabled": false,
      "libpcap_replay": true,
      "pcap_source_interface": "eth1",
      "accept_any_dst_ip": true,
      "_use_case": "For PCAP replay testing (CTU-13, tcpreplay samples) from client VM",
      "_day11": "Client VM replays via eth1, captured on defender eth2 gateway"
    }
  },
  "node_id": "cpp_sniffer_v33_day12",
  "cluster_name": "ml-defender-dual-nic-stable",
  "profiles": {
    "lab": {
      "capture_interface": "eth1",
      "promiscuous_mode": true,
      "af_xdp_enabled": true,
      "worker_threads": 2,
      "compression_level": 1,
      "_note": "Day 11 testing profile - eth1 (WAN-facing)"
    },
    "cloud": {
      "capture_interface": "eth0",
      "promiscuous_mode": false,
      "af_xdp_enabled": true,
      "worker_threads": 8,
      "compression_level": 3
    },
    "bare_metal": {
      "capture_interface": "eth0",
      "promiscuous_mode": true,
      "af_xdp_enabled": true,
      "worker_threads": 16,
      "compression_level": 1,
      "cpu_affinity_enabled": true
