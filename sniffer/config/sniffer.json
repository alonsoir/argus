      "promiscuous_mode": true,
      "af_xdp_enabled": true,
      "worker_threads": 6,
      "compression_level": 1,
      "cpu_affinity_enabled": false,
      "_day11_config": "6 workers for dual-NIC load (8GB RAM, 6 cores available, eth2 gateway)"
    }
